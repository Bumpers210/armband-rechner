{
  "contractVersion": 1,
  "environment": "production",
  "sourceCommit": "runtime-selected-and-verified",
  "paths": {
    "websiteWebroot": "/home/www/carmaja",
    "apiWebroot": "/home/www/carmaja-production-api",
    "productPrivateRoot": "/home/www/carmaja-private-production",
    "shopPrivateRoot": "/home/www/carmaja-private-shop",
    "privateRoot": "/home/www/carmaja-private-shop",
    "programRoot": "/home/www/carmaja-private-shop/program",
    "runtimeConfig": "/home/www/carmaja-private-shop/config/runtime-config.php",
    "worker": "/home/www/carmaja-private-shop/worker.php",
    "monitorCli": "/home/www/carmaja-private-shop/monitor.php",
    "backupCli": "/home/www/carmaja-private-shop/backup.php",
    "backupDirectory": "/home/www/carmaja-private-shop/backups",
    "backupKeyFile": "/home/www/carmaja-private-shop/config/backup-key.php",
    "monitorState": "/home/www/carmaja-private-shop/monitor/state.json"
  },
  "sources": {
    "privateProgram": "website/test-api-private/program",
    "privateWorker": "website/test-api-private/worker.php",
    "privateMonitorCli": "website/test-api-private/monitor.php",
    "privateBackupCli": "website/test-api-private/backup.php",
    "publicApi": "website/production-shop-api-public"
  },
  "runtime": {
    "phpCli": "/usr/bin/php8.4",
    "cron": "*/5 * * * *",
    "workerCommand": "/usr/bin/php8.4 /home/www/carmaja-private-shop/worker.php /home/www/carmaja-private-shop/config/runtime-config.php",
    "backupCron": "17 * * * *",
    "backupCommand": "/usr/bin/php8.4 /home/www/carmaja-private-shop/backup.php create /home/www/carmaja-private-shop/config/runtime-config.php",
    "backupOffsiteTarget": "onedrive-pull://carmaja-production/Carmaja-Perlen/Backups",
    "backupServerRetentionDays": 7,
    "backupExecutionLimitSeconds": 40
  },
  "monitoring": {
    "runsWithWorker": true,
    "workerSuccessMaxAgeMinutes": 15,
    "queueBacklogMaxAgeMinutes": 15,
    "backupServerMaxAgeMinutes": 90,
    "backupOffsiteMaxAgeHours": 24,
    "storageWarningPercent": 90,
    "reminderHours": 6,
    "stateChangesOnly": true
  },
  "shop": {
    "apiVersion": 2,
    "salesModel": "collection",
    "paymentMethodTypes": ["card", "klarna", "sepa_debit"],
    "shippingMethodId": "deutsche-post-maxibrief",
    "shippingPublicName": "Deutsche Post Maxibrief",
    "shippingAmountMinor": 270,
    "shippingMinBusinessDays": 2,
    "shippingMaxBusinessDays": 4,
    "legalBundleId": "cmj-production-legal-2026-08-11-v4"
  },
  "guards": {
    "copyRuntimeConfig": false,
    "copyCredentials": false,
    "automaticActivation": false,
    "productionDataAccess": false,
    "publisherEnabled": false,
    "automaticApiDeployment": false,
    "automaticWebsiteDeployment": false,
    "productApiV4WritesEnabled": false,
    "collectionCommerceEnabled": false
  }
}
