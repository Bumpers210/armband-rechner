Options -Indexes
RewriteEngine On

# HTTP ohne Authentifizierungsdialog auf die geschützte HTTPS-Testdomain leiten.
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://test.carmaja-perlen.de%{REQUEST_URI} [R=302,L,NE]

AuthType Basic
AuthName "Carmaja Produktverwaltung Test"
AuthUserFile "/home/www/carmaja-private-test/auth/test-website.htpasswd"

<RequireAny>
  Require expr "%{HTTPS} != 'on'"
  Require valid-user
</RequireAny>

<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow, noimageindex"
  Header always set Cache-Control "private, no-store"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
</IfModule>
