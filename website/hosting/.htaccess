Options -Indexes
RewriteEngine On

# Fruehere Designrouten direkt auf die kanonische Hauptadresse umleiten.
RewriteRule ^(?:v2|verspielt)/?$ https://www.carmaja-perlen.de/ [R=301,L,NE,QSD]

# HTTPS und die kanonische www-Domain erzwingen; Pfade und Query-Strings bleiben erhalten.
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^www\.carmaja-perlen\.de$ [NC]
RewriteRule ^ https://www.carmaja-perlen.de%{REQUEST_URI} [R=301,L,NE]

<IfModule mod_env.c>
    SetEnv CARMAJA_STATS_FILE /home/www/carmaja/private-data/clicks.json
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
</IfModule>
