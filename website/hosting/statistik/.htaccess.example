Options -Indexes

AuthType Basic
AuthName "Carmaja-Perlen Statistik"
AuthUserFile /home/www/carmaja-production-auth/statistik.htpasswd
Require valid-user

<IfModule mod_headers.c>
  Header always set Cache-Control "private, no-store, max-age=0"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Robots-Tag "noindex, nofollow, noimageindex"
</IfModule>
